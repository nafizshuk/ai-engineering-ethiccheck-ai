<mxfile host="app.diagrams.net"><diagram id="ethiccheck-week3" name="Week 3 data pipeline"><mxGraphModel page="1" pageScale="1" pageWidth="1560" pageHeight="970" grid="1" gridSize="10" background="#F4F7FA"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="EthicCheck AI  /  Week 3 data pipeline" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontSize=48;fontColor=#112D41;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="64" y="37" width="1400" height="70" as="geometry" /></mxCell><mxCell id="sub" value="Pathway A · UTF-8 text · Batch ETL · Expands C4 versioned knowledge access" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontSize=25;fontColor=#40596A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="67" y="109" width="1400" height="40" as="geometry" /></mxCell><mxCell id="source" value="&lt;b&gt;01 / Source&lt;/b&gt;&lt;br&gt;&lt;br&gt;Two EthicCheck TXT guides&lt;br&gt;5 NIST-linked review criteria&lt;br&gt;Version 1.0 and cited sections" style="rounded=1;html=1;arcSize=10;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fillColor=#E7F3EF;strokeColor=#538673;strokeWidth=2;fontColor=#112D41;fontSize=22;" vertex="1" parent="1"><mxGeometry x="66" y="183" width="414" height="177" as="geometry" /></mxCell><mxCell id="ingest" value="&lt;b&gt;02 / Ingest&lt;/b&gt;&lt;br&gt;&lt;br&gt;Read exact source paths&lt;br&gt;Confirm expected SHA-256&lt;br&gt;Reject missing or changed input" style="rounded=1;html=1;arcSize=10;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fillColor=#E7F3EF;strokeColor=#538673;strokeWidth=2;fontColor=#112D41;fontSize=22;" vertex="1" parent="1"><mxGeometry x="570" y="183" width="414" height="177" as="geometry" /></mxCell><mxCell id="inspect" value="&lt;b&gt;03 / Inspect&lt;/b&gt;&lt;br&gt;&lt;br&gt;Decode UTF-8 and parse headings&lt;br&gt;Check expected criteria and text&lt;br&gt;Preserve physical TXT line ranges" style="rounded=1;html=1;arcSize=10;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fillColor=#E7F3EF;strokeColor=#538673;strokeWidth=2;fontColor=#112D41;fontSize=22;" vertex="1" parent="1"><mxGeometry x="1074" y="183" width="414" height="177" as="geometry" /></mxCell><mxCell id="prepare" value="&lt;b&gt;04 / Prepare&lt;/b&gt;&lt;br&gt;&lt;br&gt;Group whole paragraphs&lt;br&gt;Keep chunks within 520 characters&lt;br&gt;Preserve criterion and offsets" style="rounded=1;html=1;arcSize=10;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fillColor=#E9F0FF;strokeColor=#6784B2;strokeWidth=2;fontColor=#112D41;fontSize=22;" vertex="1" parent="1"><mxGeometry x="1074" y="459" width="414" height="177" as="geometry" /></mxCell><mxCell id="validate" value="&lt;b&gt;05 / Validate and store&lt;/b&gt;&lt;br&gt;&lt;br&gt;Read back 8 JSONL records&lt;br&gt;Verify text, locations and references&lt;br&gt;Write Part B and Part C exports" style="rounded=1;html=1;arcSize=10;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fillColor=#E9F0FF;strokeColor=#6784B2;strokeWidth=2;fontColor=#112D41;fontSize=22;" vertex="1" parent="1"><mxGeometry x="570" y="459" width="414" height="177" as="geometry" /></mxCell><mxCell id="lineage" value="&lt;b&gt;06 / Record and rerun&lt;/b&gt;&lt;br&gt;&lt;br&gt;Save source-to-export hashes&lt;br&gt;Compare two independent runs&lt;br&gt;Match byte size, count and mappings" style="rounded=1;html=1;arcSize=10;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fillColor=#E9F0FF;strokeColor=#6784B2;strokeWidth=2;fontColor=#112D41;fontSize=22;" vertex="1" parent="1"><mxGeometry x="66" y="459" width="414" height="177" as="geometry" /></mxCell><mxCell id="e1" source="source" target="ingest" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#4A6577;strokeWidth=3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" source="ingest" target="inspect" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#4A6577;strokeWidth=3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" source="inspect" target="prepare" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#4A6577;strokeWidth=3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" source="prepare" target="validate" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#4A6577;strokeWidth=3;exitX=0;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" source="validate" target="lineage" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#4A6577;strokeWidth=3;exitX=0;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="failure1" value="&lt;b&gt;Failure at ingest&lt;/b&gt;&lt;br&gt;&lt;br&gt;Missing source or changed hash&lt;br&gt;Stop and verify the approved file before rerunning." style="rounded=1;html=1;arcSize=10;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fillColor=#FFF1DE;strokeColor=#AF8752;strokeWidth=2;fontColor=#112D41;fontSize=22;" vertex="1" parent="1"><mxGeometry x="66" y="710" width="684" height="156" as="geometry" /></mxCell><mxCell id="failure2" value="&lt;b&gt;Failure at validation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Invalid chunks, missing references or rerun mismatch&lt;br&gt;Stop before replacing the verified export." style="rounded=1;html=1;arcSize=10;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fillColor=#FFF1DE;strokeColor=#AF8752;strokeWidth=2;fontColor=#112D41;fontSize=22;" vertex="1" parent="1"><mxGeometry x="804" y="710" width="684" height="156" as="geometry" /></mxCell><mxCell id="foot" value="Observed output   2 sources · 5 criteria · 8 records · 7,549 bytes · Repeatability PASS" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontSize=24;fontColor=#112D41;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="66" y="903" width="1420" height="40" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>