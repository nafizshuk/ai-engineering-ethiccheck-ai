<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="ethiccheck-v1" name="EthicCheck AI V1"><mxGraphModel dx="2400" dy="1650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1650" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="EthicCheck AI  /  V1 Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Segoe UI;fontSize=48;fontColor=#173047;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="48" width="2200" height="70" as="geometry" /></mxCell><mxCell id="subtitle" value="Evidence-based report feedback for students  |  Week 2 conceptual design  |  Technology choices deferred" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Segoe UI;fontSize=25;fontColor=#496173;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="72" y="120" width="2200" height="40" as="geometry" /></mxCell><mxCell id="lane1" value="APPROVED KNOWLEDGE  /  separate from uploaded reports" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Segoe UI;fontSize=20;fontColor=#496173;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="72" y="174" width="1300" height="35" as="geometry" /></mxCell><mxCell id="K0" value="&lt;b&gt;K0  Approved public guidance&lt;/b&gt;&lt;br&gt;&lt;br&gt;UNESCO / NIST / Microsoft&lt;br&gt;Permitted local reference copies&lt;br&gt;Publisher, version and section" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E6F4EB;strokeColor=#5C9471;strokeWidth=2;fontColor=#173047;fontFamily=Segoe UI;fontSize=24;align=left;verticalAlign=middle;spacing=22;" vertex="1" parent="1"><mxGeometry x="70" y="220" width="430" height="190" as="geometry" /></mxCell><mxCell id="C4" value="&lt;b&gt;C4  Versioned knowledge access&lt;/b&gt;&lt;br&gt;&lt;br&gt;Prepare and retrieve guidance&lt;br&gt;Keep stable source identifiers&lt;br&gt;FR4 / NFR5 / RAI1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E6F4EB;strokeColor=#5C9471;strokeWidth=2;fontColor=#173047;fontFamily=Segoe UI;fontSize=24;align=left;verticalAlign=middle;spacing=22;" vertex="1" parent="1"><mxGeometry x="650" y="220" width="600" height="190" as="geometry" /></mxCell><mxCell id="C1" value="&lt;b&gt;C1  Student / interface&lt;/b&gt;&lt;br&gt;&lt;br&gt;Upload and preview report&lt;br&gt;Confirm assessment / clear&lt;br&gt;FR1 / FR2 / FR7" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EDF1F5;strokeColor=#8B9AA8;strokeWidth=2;fontColor=#173047;fontFamily=Segoe UI;fontSize=24;align=left;verticalAlign=middle;spacing=22;" vertex="1" parent="1"><mxGeometry x="70" y="580" width="380" height="220" as="geometry" /></mxCell><mxCell id="C2" value="&lt;b&gt;C2  Intake and privacy gate&lt;/b&gt;&lt;br&gt;&lt;br&gt;File limits and extraction&lt;br&gt;Local identifier check&lt;br&gt;Reject with reason -&amp;gt; interface&lt;br&gt;FR1 / FR2 / RAI3 / RAI4" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF0DE;strokeColor=#C98C45;strokeWidth=2;fontColor=#173047;fontFamily=Segoe UI;fontSize=24;align=left;verticalAlign=middle;spacing=22;" vertex="1" parent="1"><mxGeometry x="550" y="580" width="450" height="220" as="geometry" /></mxCell><mxCell id="C5" value="&lt;b&gt;C5  Assessment orchestration&lt;/b&gt;&lt;br&gt;&lt;br&gt;Five-category rubric + retrieval&lt;br&gt;Separate instructions from data&lt;br&gt;Bounded request / deadline&lt;br&gt;FR3 / FR4 / RAI2 / RAI4" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E7EFFC;strokeColor=#658BC0;strokeWidth=2;fontColor=#173047;fontFamily=Segoe UI;fontSize=24;align=left;verticalAlign=middle;spacing=22;" vertex="1" parent="1"><mxGeometry x="1120" y="580" width="510" height="220" as="geometry" /></mxCell><mxCell id="C6" value="&lt;b&gt;C6  Language-model capability&lt;/b&gt;&lt;br&gt;&lt;br&gt;Generate structured findings&lt;br&gt;Permitted evidence only&lt;br&gt;No tools or arbitrary browsing&lt;br&gt;FR3 / FR5 / NFR1 / NFR4" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E7EFFC;strokeColor=#658BC0;strokeWidth=2;fontColor=#173047;fontFamily=Segoe UI;fontSize=24;align=left;verticalAlign=middle;spacing=22;" vertex="1" parent="1"><mxGeometry x="1770" y="580" width="510" height="220" as="geometry" /></mxCell><mxCell id="C3" value="&lt;b&gt;C3  Temporary report session&lt;/b&gt;&lt;br&gt;&lt;br&gt;Text + page / line references&lt;br&gt;Clear or 15-minute idle expiry&lt;br&gt;Never added to knowledge index&lt;br&gt;FR2 / FR7 / RAI3" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E6F4EB;strokeColor=#5C9471;strokeWidth=2;fontColor=#173047;fontFamily=Segoe UI;fontSize=24;align=left;verticalAlign=middle;spacing=22;" vertex="1" parent="1"><mxGeometry x="550" y="990" width="450" height="220" as="geometry" /></mxCell><mxCell id="C8" value="&lt;b&gt;C8  Feedback and human review&lt;/b&gt;&lt;br&gt;&lt;br&gt;Five outcomes, evidence, citations&lt;br&gt;Explanations + next actions&lt;br&gt;Limitations; student/lecturer review&lt;br&gt;FR5 / RAI2 / RAI6" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EDF1F5;strokeColor=#8B9AA8;strokeWidth=2;fontColor=#173047;fontFamily=Segoe UI;fontSize=24;align=left;verticalAlign=middle;spacing=22;" vertex="1" parent="1"><mxGeometry x="1120" y="990" width="510" height="220" as="geometry" /></mxCell><mxCell id="C7" value="&lt;b&gt;C7  Evidence and output checks&lt;/b&gt;&lt;br&gt;&lt;br&gt;Schema + source/location checks&lt;br&gt;Reject invalid references&lt;br&gt;Failure -&amp;gt; explicit error / abstention&lt;br&gt;FR4 / RAI1 / RAI6" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF0DE;strokeColor=#C98C45;strokeWidth=2;fontColor=#173047;fontFamily=Segoe UI;fontSize=24;align=left;verticalAlign=middle;spacing=22;" vertex="1" parent="1"><mxGeometry x="1770" y="990" width="510" height="220" as="geometry" /></mxCell><mxCell id="C9" value="&lt;b&gt;C9  Offline evaluation and measurements&lt;/b&gt;&lt;br&gt;&lt;br&gt;Synthetic fixtures probe C2-C8  |  Human semantic review  |  E1-E12&lt;br&gt;Timing, status and usage only in routine logs; no raw reports  |  O3 / NFR1-NFR5 / RAI1-RAI6" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EEE8FA;strokeColor=#9576B5;strokeWidth=2;fontColor=#173047;fontFamily=Segoe UI;fontSize=24;align=left;verticalAlign=middle;spacing=22;" vertex="1" parent="1"><mxGeometry x="550" y="1380" width="1730" height="180" as="geometry" /></mxCell><mxCell id="design-note" value="CONCEPTUAL, NOT IMPLEMENTED&lt;br&gt;One small application can contain these capabilities.&lt;br&gt;Report text is untrusted input.&lt;br&gt;Deployment and provider data handling remain to be decided." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Segoe UI;fontSize=24;fontColor=#496173;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1480" y="240" width="820" height="155" as="geometry" /></mxCell><mxCell id="lane2" value="ASSESSMENT PATH  /  one report at a time" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Segoe UI;fontSize=20;fontColor=#496173;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="72" y="515" width="1300" height="35" as="geometry" /></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#526B7C;strokeWidth=2;dashed=0;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="K0" target="C4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1label" value="Approved&lt;br&gt;references" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Segoe UI;fontSize=21;fontCol